generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  ADMIN
  USER
  MODERATOR
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  role       Roles    @default(USER)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
