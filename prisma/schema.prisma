generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  ADMIN
  USER
  MODERATOR
}

enum TableRole {
  OWNER
  EDITOR
  VIEWER
}

enum InviteStatus {
  pending
  accepted
  declined
}

model User {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  email        String         @unique
  password     String
  telegram_id  String?
  notification Boolean        @default(false)
  role         Roles          @default(USER)
  created_at   DateTime       @default(now())
  updated_at   DateTime       @updatedAt
  fcn_tokens   UserFcmToken[]
  tables       UserToTable[]
  tableInvites TableInvite[]

  @@index([name, email])
}

model UserFcmToken {
  id        Int           @id @default(autoincrement())
  user_id   Int
  token     String        @unique
  platform  String
  createdAt DateTime      @default(now())
  invite    TableInvite[]
  user      User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Table {
  id         Int           @id @default(autoincrement())
  name       String
  columns    Column[]
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
  owner_id   Int?
  users      UserToTable[]
  invite     TableInvite[]

  @@index([name])
}

model TableInvite {
  id        Int          @id @default(autoincrement())
  table_id  Int
  user_id   Int // тот, кого приглашаем
  owner_id  Int // кто пригласил
  status    InviteStatus @default(pending)
  createdAt DateTime     @default(now())

  table          Table         @relation(fields: [table_id], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  userFcmToken   UserFcmToken? @relation(fields: [userFcmTokenId], references: [id])
  userFcmTokenId Int?
}

model UserToTable {
  user_id  Int
  table_id Int
  role     TableRole @default(VIEWER)

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  table      Table    @relation(fields: [table_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@id([user_id, table_id])
}

model Column {
  id         Int      @id @default(autoincrement())
  data       Json
  table_id   Int
  table      Table    @relation(fields: [table_id], references: [id], onDelete: Cascade)
  cards      Card[]
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([id, table_id])
}

model Card {
  id         Int      @id @default(autoincrement())
  data       Json
  column_id  Int
  column     Column   @relation(fields: [column_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([id, column_id])
}

model AuditLog {
  id   Int  @id @default(autoincrement())
  data Json
}

model TgLinkToken {
  token     String   @id
  email     String
  used      Boolean  @default(false)
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([email])
}
